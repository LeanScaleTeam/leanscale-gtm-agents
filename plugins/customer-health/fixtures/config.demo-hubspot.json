{
  "_comment": "Demo plugin config for the HubSpot-shaped offline fixture (fixtures/raw-hubspot). Note that only crm_fields and customer_definition change between this file and config.demo.json — the model, the weights and the thresholds are identical, because analyze.py never branches on CRM vendor.",
  "schema_version": 1,
  "window_days": 180,
  "notice_window_days": 60,

  "customer_definition": {
    "crm": "hubspot",
    "account_filter_hubspot_property": "lifecyclestage",
    "account_filter_hubspot_value": "customer",
    "exclude_account_ids": [],
    "include_paused": false
  },

  "renewal_source": "renewal_opportunity",

  "crm_fields": {
    "account_arr": ["arr"],
    "account_arr_is_monthly": false,
    "account_name": ["name"],
    "account_owner": ["hubspot_owner_id"],
    "account_segment": ["segment"],
    "renewal_date": ["renewal_date", "closedate"],
    "contract_start": ["contract_start_date"],
    "auto_renew": ["auto_renew"],
    "champion_contact": ["champion_contact"],
    "economic_buyer": ["economic_buyer"],
    "contact_is_active": ["is_active"],
    "contact_bounced_at": ["hs_email_hard_bounce_reason"]
  },

  "quadrant": { "sentiment_floor": 60, "risk_threshold": 50 },
  "risk_floors": {
    "unsigned_renewal_inside_window": 55,
    "unsigned_renewal_critical": 80,
    "champion_departed": 62
  },

  "support_source": null,
  "usage_source": null,

