    "contact_email_exact": "an attendee email matches a contact on the record",
    "attendee_domain": "an attendee's email domain matches the account's website domain",
    "single_open_opp": "the matched account has exactly one open opportunity",
    "recent_activity": "the record shows activity in the last 30 days"
  },
